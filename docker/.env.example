# 기기별 설정. 복사해서 사용: cp docker/.env.example docker/.env  (docker/.env는 git에 올라가지 않음)

# 이미지
IMAGE=twkim00/streammapnet:1.0

# 컨테이너 이름 (같은 서버를 여러 명이 쓰면 겹치지 않게)
CONTAINER_NAME=streammapnet_taeu

# NAS 전체 (컨테이너 안에서 /nas2 로 보임). 없으면 비워두기
NAS_DIR=/home/taeu/nas2

# 데이터셋 경로 (호스트 기준). 코드의 ./datasets/<이름> 으로 마운트됨. 없으면 비워두기
NUSCENES_DIR=/home/taeu/nas2/Rotem_dataset/nuscenes
AV2_DIR=

# 사용할 GPU (all 또는 0,1 처럼)
GPUS=all
